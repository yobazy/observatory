{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Observatory",
  "version": "0.4.0",
  "identifier": "dev.bazil.observatory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Observatory",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#131a2a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 180
        }
      },
      "signingIdentity": "-"
    }
  }
}
